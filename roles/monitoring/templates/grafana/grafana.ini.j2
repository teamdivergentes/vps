# {{ ansible_managed }}
[server]
http_port = 3001
root_url = https://{{ grafana_domain }}
serve_from_sub_path = false

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}
disable_gravatar = true

[users]
allow_sign_up = false
allow_org_create = false

[auth.anonymous]
enabled = false

[dashboards]
default_home_dashboard_path = /var/lib/grafana/dashboards/01-overview.json

[alerting]
enabled = false

[unified_alerting]
enabled = false

[log]
mode = console
level = warn
