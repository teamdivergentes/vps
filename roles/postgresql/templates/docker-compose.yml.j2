# {{ ansible_managed }}
# Shared PostgreSQL 17 - website (preprod + prod) + discord bot
services:
  postgres:
    image: postgres:17-alpine
    container_name: dvg-shared-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ shared_pg_user }}
      POSTGRES_PASSWORD: {{ shared_pg_password }}
      POSTGRES_DB: postgres
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./init:/docker-entrypoint-initdb.d:ro
    networks:
      - {{ docker_network }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ shared_pg_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=false"

volumes:
  postgres-data:

networks:
  {{ docker_network }}:
    external: true
