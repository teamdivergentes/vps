# {{ ansible_managed }}
# Website stack - {{ env }}
# Uses shared PostgreSQL instance (dvg-shared-postgres)
services:
  backend:
    image: {{ backend_image }}
    container_name: website-{{ env }}-backend
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - backend-uploads:/app/uploads
    networks:
      - {{ docker_network }}
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:3000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.api-{{ env }}.rule=(Host(`{{ site_domain }}`){% if extra_domains is defined %} || Host(`{{ extra_domains }}`){% endif %}) && PathPrefix(`/api`)"
      - "traefik.http.routers.api-{{ env }}.entrypoints=websecure"
      - "traefik.http.routers.api-{{ env }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.api-{{ env }}.middlewares=security-headers@file,rate-limit@file"
      - "traefik.http.services.api-{{ env }}.loadbalancer.server.port=3000"
      - "traefik.docker.network={{ docker_network }}"

  frontend:
    image: {{ frontend_image }}
    container_name: website-{{ env }}-frontend
    restart: unless-stopped
    environment:
      - BACKEND_URL=http://website-{{ env }}-backend:3000
      - ROBOTS_ALLOW={{ robots_allow | default('false') }}
      - SITE_URL=https://{{ site_domain }}
{% if google_analytics_id is defined and google_analytics_id %}
      - GOOGLE_ANALYTICS_ID={{ google_analytics_id }}
{% endif %}
    depends_on:
      backend:
        condition: service_healthy
    networks:
      - {{ docker_network }}
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://127.0.0.1:80/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.website-{{ env }}.rule=Host(`{{ site_domain }}`){% if extra_domains is defined %} || Host(`{{ extra_domains }}`){% endif %}"
      - "traefik.http.routers.website-{{ env }}.entrypoints=websecure"
      - "traefik.http.routers.website-{{ env }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.website-{{ env }}.middlewares=security-headers@file"
      - "traefik.http.services.website-{{ env }}.loadbalancer.server.port=80"
      - "traefik.docker.network={{ docker_network }}"

volumes:
  backend-uploads:

networks:
  {{ docker_network }}:
    external: true
