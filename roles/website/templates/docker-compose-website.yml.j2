# {{ ansible_managed }}
# Website stack - {{ env }}
# Uses shared PostgreSQL instance (dvg-shared-postgres)
services:
  backend:
    image: {{ backend_image }}
    container_name: website-{{ env }}-backend
    restart: unless-stopped
    mem_limit: 512m
    cpus: 0.5
    security_opt:
      - no-new-privileges:true
    env_file:
      - .env
    volumes:
      - backend-uploads:/app/uploads
    networks:
      - {{ docker_network }}
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:3000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.api-{{ env }}.rule=(Host(`{{ site_domain }}`){% if extra_domains is defined %} || Host(`{{ extra_domains }}`){% endif %}) && PathPrefix(`/api`)"
      - "traefik.http.routers.api-{{ env }}.entrypoints=websecure"
      - "traefik.http.routers.api-{{ env }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.api-{{ env }}.middlewares=security-headers@file,rate-limit@file"
      - "traefik.http.services.api-{{ env }}.loadbalancer.server.port=3000"
      - "traefik.docker.network={{ docker_network }}"

  frontend:
    image: {{ frontend_image }}
    container_name: website-{{ env }}-frontend
    restart: unless-stopped
    # Le conteneur frontend ne sert plus seulement des fichiers statiques : depuis
    # l'EPIC-29, il fait tourner Nginx **et** un process Node qui rend les pages
    # publiques cote serveur. Les limites d'origine dimensionnaient un nginx:alpine.
    #
    # Mesures du 2026-08-06 sur l'image de production, avec 128m / 0.2 CPU :
    #   - 24 Mo au repos, 74 Mo apres une rafale de 10 rendus concurrents
    #   - un rendu a froid prend 0,9 a 1,4 s
    # Cela tenait, mais avec 42 % de marge seulement, et un TTFB d'une seconde sur
    # toute page sortie du microcache. Node liberant sa memoire paresseusement, la
    # marge se reduit encore avec le temps et la diversite des pages rendues.
    mem_limit: 256m
    cpus: 0.5
    security_opt:
      - no-new-privileges:true
    environment:
      - BACKEND_URL=http://website-{{ env }}-backend:3000
      - ROBOTS_ALLOW={{ robots_allow | default('false') }}
      - SITE_URL=https://{{ site_domain }}
{% if google_analytics_id is defined and google_analytics_id %}
      - GOOGLE_ANALYTICS_ID={{ google_analytics_id }}
{% endif %}
{% if matomo_url is defined and matomo_url and matomo_site_id is defined and matomo_site_id %}
      - MATOMO_URL={{ matomo_url }}
      - MATOMO_SITE_ID={{ matomo_site_id }}
{% endif %}
    depends_on:
      backend:
        condition: service_healthy
    networks:
      - {{ docker_network }}
    healthcheck:
      # `curl` venait de l'image nginx:alpine ; l'image est desormais basee sur
      # node:22-alpine, qui ne l'embarque pas. Verifie le 2026-08-06 : la sonde
      # sortait en code 127 « curl: not found » et le conteneur restait
      # durablement `unhealthy` alors qu'il servait normalement. On aligne sur le
      # backend, qui utilise deja wget.
      #
      # `/health` traverse Nginx puis interroge le process de rendu : la sonde
      # valide donc la chaine entiere, et non le seul serveur web.
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:80/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.website-{{ env }}.rule=Host(`{{ site_domain }}`){% if extra_domains is defined %} || Host(`{{ extra_domains }}`){% endif %}"
      - "traefik.http.routers.website-{{ env }}.entrypoints=websecure"
      - "traefik.http.routers.website-{{ env }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.website-{{ env }}.middlewares=security-headers@file,rate-limit@file"
      - "traefik.http.services.website-{{ env }}.loadbalancer.server.port=80"
      - "traefik.docker.network={{ docker_network }}"

volumes:
  backend-uploads:

networks:
  {{ docker_network }}:
    external: true
