# {{ ansible_managed }}
# Website {{ env }} environment

# Database (shared PostgreSQL instance)
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@dvg-shared-postgres:5432/{{ db_name }}
POSTGRES_USER={{ db_user }}
POSTGRES_PASSWORD={{ db_password }}
POSTGRES_DB={{ db_name }}

# App
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://{{ site_domain }}
# Base des URLs du sitemap et des donnees structurees. Sans elle, le backend
# retombe sur `https://teamdivergentes.fr` : le sitemap de la preprod
# annoncerait alors les URLs de la production.
SITE_URL=https://{{ site_domain }}
# Origines autorisees en CORS. Sans elle, le repli du code n'autorise que
# `localhost` — sans consequence tant que le navigateur passe par le proxy
# Nginx (meme origine), mais le repli decrit un poste de developpement, pas cet
# environnement.
CORS_ORIGIN=https://{{ site_domain }}

# JWT
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRES_IN=1d

# Google Analytics (GA4 Data API)
GA_PROPERTY_ID={{ ga_property_id }}
GA_STREAM_ID={{ ga_stream_id }}
GA_CLIENT_EMAIL={{ ga_client_email }}
GA_PRIVATE_KEY="{{ ga_private_key }}"

# Twitch API
TWITCH_CLIENT_ID={{ twitch_client_id }}
TWITCH_CLIENT_SECRET={{ twitch_client_secret }}

# Stripe (boutique)
# Cles distinctes par environnement : la preprod encaisse en mode test, la prod
# en live. Un `sk_live_` sur la preprod facturerait de vrais clients pendant une
# recette. Vides tant que le compte n'est pas ouvert : la boutique refuse alors
# le paiement au lieu de demarrer avec une cle absente.
STRIPE_SECRET_KEY={{ stripe_secret_key }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret }}
SHOP_SUCCESS_URL=https://{{ site_domain }}/boutique/merci
SHOP_CANCEL_URL=https://{{ site_domain }}/boutique/panier
# Origine des liens legaux dans les mails de commande. Sans elle, le backend
# derive l'origine de SHOP_SUCCESS_URL : correct aujourd'hui, mais implicite.
SHOP_PUBLIC_URL=https://{{ site_domain }}
# Delai annonce au client dans le mail de confirmation. Sans cette valeur, le
# backend retombe sur le delai legal de 30 jours (art. L216-1 C. conso) en
# journalisant une erreur — soit 5 jours de plus que ce qu'affiche le site.
SHOP_DELIVERY_DELAY_TEXT={{ shop_delivery_delay_text }}
