# {{ ansible_managed }}
# ----------------------------------------------------------------------------
# GitHub Actions self-hosted runner (dockerized) — multi-runner
#
# Image : myoung34/github-runner — s'enregistre automatiquement avec ACCESS_TOKEN.
#
# Mode reseau :
#   - "host"   : le runner partage la stack reseau de l'hote. Requis pour les
#                jobs qui font `docker compose up` + `curl localhost:PORT`
#                (ex : e2e-fullstack). C'est le mode par defaut (voir
#                inventory/group_vars/all/main.yml).
#   - "bridge" : isolation stricte, mais les jobs qui ciblent `localhost` depuis
#                le runner ne voient pas les ports exposes par les containers
#                lances dans les jobs.
#
# Multi-runner :
#   github_runner_replicas (defaut 2, max 4) controle le nombre de runners.
#   Chaque instance a son propre workdir (runner-work-N), un nom unique
#   (RUNNER_NAME_PREFIX genere un suffix hash automatiquement) et partage le
#   cache Buildx (buildx-cache) pour accelerer les builds Docker.
#
# Securite :
#   - Monter /var/run/docker.sock donne un acces root effectif a l'hote.
#     Ce runner ne doit donc tourner QUE pour des repos prives de confiance.
#   - no-new-privileges + cap_drop ALL reduit la surface si le runner lui-meme
#     est compromis ; les privileges sont re-obtenus par les jobs via le socket.
#
# Ephemeral :
#   - false (defaut) : le runner reste enregistre apres le job, economise ~30s
#     de re-registration par job. Acceptable sur repos prives de confiance.
#   - true : chaque job obtient un runner vierge, etat isole garanti. A activer
#     si un fork ou un repo public non maitrise peut soumettre des jobs.
# ----------------------------------------------------------------------------
services:
{% for i in range(1, github_runner_replicas + 1) %}
  github-runner-{{ i }}:
    image: {{ github_runner_image }}:{{ github_runner_tag }}
    container_name: github-runner-{{ i }}
    restart: unless-stopped
    mem_limit: {{ github_runner_mem_limit }}
    cpus: {{ github_runner_cpus }}
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      # chown/setgid/setuid : requis par le user runner interne a l'image
      - CHOWN
      - SETGID
      - SETUID
      # dac_override : requis pour ecrire dans le workdir quand il tourne en non-root
      - DAC_OVERRIDE
      # fowner : requis pour que tar puisse chmod() les fichiers extraits lors de
      # setup-node / setup-java et autres actions qui cachent des archives.
      # Sans FOWNER, tar retourne exit code 2 ("Operation not permitted") meme
      # en root car le kernel bloque chmod sur les mountpoints overlay.
      - FOWNER
    env_file:
      - .env
    environment:
      RUNNER_SCOPE: "{{ github_runner_scope }}"
{% if github_runner_scope == 'org' %}
      ORG_NAME: "{{ github_runner_org }}"
{% elif github_runner_scope == 'repo' %}
      REPO_URL: "https://github.com/{{ github_runner_org }}/{{ github_runner_repo }}"
{% endif %}
      RUNNER_NAME_PREFIX: "{{ github_runner_name_prefix }}"
      LABELS: "{{ github_runner_labels }}"
      RUNNER_WORKDIR: "/tmp/runner/work"
      EPHEMERAL: "{{ github_runner_ephemeral | string | lower }}"
      DISABLE_AUTO_UPDATE: "true"
    volumes:
      # Docker socket : permet aux jobs de builder/lancer des containers.
      # C'est le mecanisme Docker-outside-of-Docker (DooD), pas du vrai DinD.
      - /var/run/docker.sock:/var/run/docker.sock
      # Workdir isole par runner : evite toute collision entre runners paralleles.
      - runner-work-{{ i }}:/tmp/runner
      # Cache Buildx partage entre tous les runners : les layers Docker mis en
      # cache par runner-1 sont reutilisables par runner-2, ce qui accelere
      # significativement les builds subsequents (surtout les layers node_modules
      # et les etapes de compilation NestJS/Angular).
      - buildx-cache:/home/runner/.cache/buildx
    healthcheck:
      # Verifier a la fois le process Listener, la presence du fichier .runner
      # (genere a l'enregistrement) et sa taille > 0 (token valide).
      # Un runner qui tourne sans etre connecte (token invalide, rate limit)
      # aura un .runner absent ou vide — la sonde le detecte.
      test: ["CMD-SHELL", "pgrep -f Runner.Listener >/dev/null && test -s /actions-runner/.runner"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 90s
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "3"
    labels:
      - "traefik.enable=false"
{% if github_runner_network_mode == 'host' %}
    network_mode: host
{% else %}
    networks:
      - {{ github_runner_network }}
{% endif %}

{% endfor %}
volumes:
{% for i in range(1, github_runner_replicas + 1) %}
  runner-work-{{ i }}:
{% endfor %}
  # Cache Buildx partage : layers Docker mis en cache par n'importe quel runner,
  # reutilisables par tous les runners suivants. Reduit le temps de build
  # Angular/NestJS multi-stage de 3-4 min a 1-2 min sur les jobs subsequents.
  buildx-cache:

{% if github_runner_network_mode != 'host' %}
networks:
  {{ github_runner_network }}:
    driver: bridge
{% endif %}
