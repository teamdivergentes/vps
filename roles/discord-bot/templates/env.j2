# {{ ansible_managed }}
# Discord Bot environment

# Discord
DISCORD_TOKEN={{ discord_bot_token }}
DISCORD_CLIENT_ID={{ discord_client_id }}
NODE_ENV=production

# Database (shared PostgreSQL instance)
POSTGRES_HOST=dvg-shared-postgres
POSTGRES_PORT=5432
POSTGRES_USER={{ discord_db_user }}
POSTGRES_PASSWORD={{ discord_db_password }}
POSTGRES_DB={{ discord_db_name }}
