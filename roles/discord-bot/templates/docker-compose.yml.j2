# {{ ansible_managed }}
# Discord Bot - uses shared PostgreSQL
services:
  discord-bot:
    image: {{ discord_bot_image }}:{{ discord_bot_tag }}
    container_name: discord-bot
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - ./data:/usr/src/app/data
      - ./logs:/var/log/app
    networks:
      - {{ docker_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=false"

networks:
  {{ docker_network }}:
    external: true
