# {{ ansible_managed }}
# Discord Bot - uses shared PostgreSQL
services:
  discord-bot:
    image: {{ effective_discord_bot_image }}
    container_name: discord-bot
    restart: unless-stopped
    mem_limit: 256m
    cpus: 0.3
    security_opt:
      - no-new-privileges:true
    env_file:
      - .env
    dns:
      - 8.8.8.8
      - 1.1.1.1
    volumes:
      - ./data:/usr/src/app/data
      - ./secrets:/usr/src/app/secrets:ro
      - ./logs:/var/log/app
    healthcheck:
      test: ["CMD-SHELL", "node -e \"require('dns').lookup('discord.com', (err) => process.exit(err ? 1 : 0))\""]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s
    networks:
      - {{ docker_network }}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=false"

networks:
  {{ docker_network }}:
    external: true
