# {{ ansible_managed }}
# Discord Bot
services:
  discord-bot:
    image: ghcr.io/tellebma/discord-js-dvg:{{ discord_bot_branch | regex_replace('/', '-') }}
    container_name: discord-bot
    restart: unless-stopped
    env_file:
      - .env
    networks:
      - bot-internal
    labels:
      - "traefik.enable=false"

networks:
  bot-internal:
    driver: bridge
