; {{ ansible_managed }}
[options]
; Mot de passe admin pour les opérations de base de données
admin_passwd = {{ odoo_admin_password }}

; Configuration base de données PostgreSQL
db_host = odoo-db
db_port = 5432
db_user = {{ odoo_db_user }}
db_password = {{ odoo_db_password }}
db_name = {{ odoo_db_name }}
db_maxconn = 64
db_template = template0

; Chemins des addons
addons_path = /odoo/odoo-server/odoo/addons,/odoo/odoo-server/addons,/odoo/odoo-server/enterprise,/odoo/custom-addons

; Options générales
default_productivity_apps = True
proxy_mode = True

; Fichiers de log
logfile = /var/log/odoo/odoo.log
log_level = info

; Limites de temps (en secondes)
limit_time_cpu = 1200
limit_time_real = 1200
limit_time_real_cron = 1800

; Ports
xmlrpc_port = 8069
http_port = 8069
longpolling_port = 8072

; Workers et performance
workers = 4
max_cron_threads = 1

; Limites mémoire (en octets)
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648

; Options de sécurité
list_db = False
dbfilter = .*

; Options diverses
server_wide_modules = base,web
