# {{ ansible_managed }}
# Odoo 19 with dedicated PostgreSQL 16 and Nginx reverse proxy
services:
  odoo:
    image: {{ odoo_image }}
    container_name: odoo-web
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    depends_on:
      odoo-db:
        condition: service_healthy
    environment:
      - HOST=odoo-db
      - PORT=5432
      - USER={{ odoo_db_user }}
      - PASSWORD={{ odoo_db_password | replace('$', '$$') }}
    volumes:
      - ./config/odoo.conf:/etc/odoo/odoo.conf:ro
      - odoo-custom-addons:/odoo/custom-addons
      - odoo-logs:/var/log/odoo
      - odoo-sessions:/odoo/.local
    networks:
      - odoo-internal
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8069/web/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=false"

  nginx:
    image: nginx:1.25-alpine
    container_name: odoo-nginx
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    depends_on:
      odoo:
        condition: service_healthy
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - nginx-logs:/var/log/nginx
    networks:
      - {{ docker_network }}
      - odoo-internal
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.odoo.rule=Host(`{{ odoo_domain }}`)"
      - "traefik.http.routers.odoo.entrypoints=websecure"
      - "traefik.http.routers.odoo.tls.certresolver=letsencrypt"
      - "traefik.http.routers.odoo.middlewares=security-headers@file,rate-limit@file"
      - "traefik.http.services.odoo.loadbalancer.server.port=80"
      - "traefik.docker.network={{ docker_network }}"

  odoo-db:
    image: postgres:16-alpine
    container_name: odoo-db
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      POSTGRES_DB: {{ odoo_db_name }}
      POSTGRES_USER: {{ odoo_db_user }}
      POSTGRES_PASSWORD: "{{ odoo_db_password | replace('$', '$$') }}"
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - odoo-db-data:/var/lib/postgresql/data/pgdata
    networks:
      - odoo-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ odoo_db_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=false"

volumes:
  odoo-db-data:
  odoo-custom-addons:
  odoo-logs:
  odoo-sessions:
  nginx-logs:

networks:
  odoo-internal:
    driver: bridge
  {{ docker_network }}:
    external: true
