# {{ ansible_managed }}
# Traefik Dynamic Configuration

http:
  middlewares:
    security-headers:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        frameDeny: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        customFrameOptionsValue: "SAMEORIGIN"

    rate-limit:
      rateLimit:
        average: 100
        burst: 50
        period: 1s

tls:
  options:
    default:
      minVersion: VersionTLS12
      sniStrict: true
