# {{ ansible_managed }}
services:
  traefik:
    image: traefik:v3.6
    container_name: traefik
    restart: unless-stopped
    mem_limit: 128m
    cpus: 0.3
    security_opt:
      - no-new-privileges:true
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      - ./config:/etc/traefik/config:ro
      - ./certs:/certs
      - traefik-logs:/var/log/traefik
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    networks:
      - {{ docker_network }}
    labels:
      - "traefik.enable=false"

volumes:
  traefik-logs:

networks:
  {{ docker_network }}:
    external: true
