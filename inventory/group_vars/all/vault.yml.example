---
# =============================================================================
# VAULT - Copy this file to vault.yml and encrypt with:
#   ansible-vault encrypt inventory/group_vars/all/vault.yml
# =============================================================================

vault_vps_ip: "YOUR_VPS_IP"
vault_ssh_port: 22
vault_ssh_public_keys:
  - "ssh-ed25519 AAAA... your-key-1"
  - "ssh-ed25519 AAAA... your-key-2 (optional)"

# -- Docker registries - for pulling pre-built Docker images -------------------
vault_ghcr_user: "your-github-username"
vault_ghcr_token: "ghp_xxxxxxxxxxxx"
vault_dockerhub_user: "your-dockerhub-username"
vault_dockerhub_token: "dckr_pat_xxxxxxxxxxxx"

# -- Shared PostgreSQL (website + discord bot) ---------------------------------
vault_shared_pg_user: "dvg_admin"
vault_shared_pg_password: "CHANGE_ME_shared_pg_password"

# -- Preprod website DB --------------------------------------------------------
vault_preprod_db_password: "CHANGE_ME_preprod_password"
vault_preprod_db_name: "dvg_preprod"
vault_preprod_db_user: "dvg_preprod"
vault_preprod_jwt_secret: "CHANGE_ME_preprod_jwt_secret"

# -- Prod website DB -----------------------------------------------------------
vault_prod_db_password: "CHANGE_ME_prod_password"
vault_prod_db_name: "dvg_prod"
vault_prod_db_user: "dvg_prod"
vault_prod_jwt_secret: "CHANGE_ME_prod_jwt_secret"

# -- Odoo (dedicated PG) ------------------------------------------------------
vault_odoo_db_user: "odoo19"
vault_odoo_db_name: "odoo19"
vault_odoo_db_password: "CHANGE_ME_odoo_db_password"
vault_odoo_admin_password: "CHANGE_ME_odoo_admin_password"

# -- Discord bot ---------------------------------------------------------------
vault_discord_bot_token: "YOUR_DISCORD_BOT_TOKEN"
vault_discord_client_id: "YOUR_DISCORD_CLIENT_ID"
vault_discord_db_name: "discord_bot"
vault_discord_db_user: "discord_bot"
vault_discord_db_password: "CHANGE_ME_discord_db_password"
vault_discord_gemini_api_key: "YOUR_GEMINI_API_KEY"
vault_discord_google_credentials: |
  {
    "type": "service_account",
    "project_id": "YOUR_PROJECT_ID",
    ...
  }

# -- Google Analytics (Service Account for GA4 Data API) ----------------------
vault_ga_property_id: "123456789"
vault_ga_client_email: "dvg-analytics-reader@your-project.iam.gserviceaccount.com"
vault_ga_private_key: |
  -----BEGIN PRIVATE KEY-----
  PASTE_YOUR_PRIVATE_KEY_HERE
  -----END PRIVATE KEY-----

# -- pgAdmin -------------------------------------------------------------------
vault_pgadmin_password: "CHANGE_ME_pgadmin_password"
