---
# =============================================================================
# VAULT - Copy this file to vault.yml and encrypt with:
#   ansible-vault encrypt inventory/group_vars/vault.yml
# =============================================================================

vault_vps_ip: "YOUR_VPS_IP"
vault_ssh_port: 22
vault_ssh_public_key: "ssh-ed25519 AAAA... your-key"

# -- GitHub deploy token (for private repos) -----------------------------------
vault_github_token: "ghp_xxxxxxxxxxxx"

# -- Preprod DB ----------------------------------------------------------------
vault_preprod_db_password: "CHANGE_ME_preprod_strong_password"
vault_preprod_db_name: "website_preprod"
vault_preprod_db_user: "website_preprod"

# -- Prod DB -------------------------------------------------------------------
vault_prod_db_password: "CHANGE_ME_prod_strong_password"
vault_prod_db_name: "website_prod"
vault_prod_db_user: "website_prod"

# -- Odoo ----------------------------------------------------------------------
vault_odoo_db_password: "CHANGE_ME_odoo_db_password"
vault_odoo_admin_password: "CHANGE_ME_odoo_admin_password"

# -- Discord -------------------------------------------------------------------
vault_discord_bot_token: "YOUR_DISCORD_BOT_TOKEN"
